# ---- Environment files ----
.env
.env.*
!.env.example

# ---- Composer ----
/vendor/

# ---- Node / Frontend ----
/node_modules/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*

# ---- Laravel Storage ----
/storage/*.key
/storage/app/*
!/storage/app/public
/storage/framework/*
!/storage/framework/cache
!/storage/framework/sessions
!/storage/framework/views
/storage/logs/*

# ---- Public build assets ----
/public/build/
/public/hot

# ---- Filament ----
/public/filament
/public/vendor/filament

# ---- Cache / Logs ----
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# ---- PHPUnit ----
/.phpunit.cache
/.phpunit.result.cache

# ---- IDE / Editor ----
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ---- OS Files ----
.DS_Store
Thumbs.db

# ---- Debug ----
*.log

# ---- Temporary / Backup ----
*.bak
*.tmp
*.swp

# ---- Laravel Sail ----
/docker-compose.override.yml

# ---- Coverage ----
/coverage/
